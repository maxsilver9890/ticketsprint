{
  "name": "ticketsprint",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.11.0" },
  "scripts": {
    "dev": "pnpm --parallel --filter @ticketsprint/web --filter @ticketsprint/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
