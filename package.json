{
  "name": "ticketsprint",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ticketsprint/web --filter @ticketsprint/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @ticketsprint/api db:generate",
    "db:migrate:dev": "pnpm --filter @ticketsprint/api db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @ticketsprint/api db:migrate:deploy",
    "db:seed": "pnpm --filter @ticketsprint/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
